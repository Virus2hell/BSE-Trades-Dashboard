# ---------- Mock BSE API ----------
BSE_PORT=4000
# How long a full pull takes (ms). Spec: 15 minutes = 900000. Use 20000 for a quick demo.
PULL_DELAY_MS=900000
# Number of seeded historical trades returned by the first pull
BASE_TRADES=3000
# How many brand-new trades "happen on the exchange" between pulls
NEW_TRADES_MIN=40
NEW_TRADES_MAX=150
# Deterministic seed for the generated data
SEED=42
# Simulates the corporate network: any TCP connection older than this is killed (0 = off)
NETWORK_MAX_CONN_MS=30000
# Shared secret used to sign the "pull ready" webhook (HMAC-SHA256)
WEBHOOK_SECRET=change-me-in-prod

# ---------- Dashboard ----------
DASHBOARD_PORT=3000
# Where the dashboard backend reaches the BSE API
BSE_BASE_URL=http://127.0.0.1:4000
# URL at which the BSE API can reach the dashboard's webhook (must be reachable from BSE)
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3000
# Where pulled trades are persisted
DATA_FILE=./data/store.json
# Server recycles each SSE stream before the 30 s network limit; browser resumes with Last-Event-ID (0 = never recycle)
SSE_MAX_CONN_MS=25000
SSE_HEARTBEAT_MS=10000
